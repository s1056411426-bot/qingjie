{
  "name": "qingjie",
  "version": "0.1.4",
  "description": "轻截 — 本地截图、标注、贴图与文字识别",
  "main": "src/main.cjs",
  "author": "Qingjie",
  "license": "MIT",
  "allowScripts": {
    "electron": true,
    "tesseract.js": false,
    "app-builder-bin": true
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:app": "node scripts/smoke.cjs",
    "assets": "npm run icons && node scripts/assets.cjs",
    "dist:win": "npm run assets && electron-builder --win portable --x64",
    "dist:mac": "npm run assets && electron-builder --mac dmg zip --arm64 --x64",
    "icons": "node scripts/icons.cjs"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@icon-park/svg": "1.4.2",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "playwright": "1.58.2"
  },
  "build": {
    "appId": "com.qingjie.desktop",
    "productName": "轻截",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/ocr",
        "to": "ocr"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.qingjie.txt"
      },
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asarUnpack": [
      "node_modules/**"
    ],
    "artifactName": "Qingjie-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "轻截需要屏幕访问权限来截图和拼接长截图。图片仅在本机处理。"
      }
    }
  }
}
